includes:
    - ./vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    tmpDir: tmp
    phpVersion: 80300

    scanFiles:
        - libs/GlobalController.php
        - helpers/formhandler.php

    paths:
        - app/

    # Level 9 is the highest level
    level: 8

    ignoreErrors:
        # We can do this since Authenticate Middleware will redirect to login if not authenticated  
        - '#Cannot access property \$[a-zA-Z0-9\\_]+ on App\\Models\\User\|null#'

        # We can do this since Authenticate Middleware will redirect to login if not authenticated
        - '#Parameter \#\d+ \$[a-zA-Z0-9_]+ of (method|function) [a-zA-Z0-9\\_:]+\(\) expects App\\Models\\User, App\\Models\\User\|null given\.#'

    excludePaths:
        - app/Models/Adventures_model.php
        - app/Models/Artefact_model.php
        - app/Models/SetAdventure_model.php
        - app/Models/UpdateGamedata_model.php
        - app/Models/UpdateAdventure_model.php
        - ./vendor/*
        - ./libs/*

